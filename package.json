{
  "name": "omnipark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:copertura": "vitest run --config vitest.copertura.config.ts --coverage",
    "test:e2e": "playwright test --grep-invert \"@lenta|@misura\"",
    "test:e2e:lenta": "playwright test --grep @lenta",
    "misura:e2e": "playwright test --grep @misura",
    "db:migrate": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/persistence/cli/migra.ts",
    "db:reset": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/persistence/cli/reset.ts",
    "sim:sensori": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/simulators/sensori.ts",
    "sim:anpr": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/simulators/anpr.ts",
    "misura:anpr": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/misuraAnpr.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
